# Maintainer: CharOfString <root@charofstring.cc>
pkgname=gxde-picker-git
pkgver=2.0.4
pkgrel=1
pkgdesc='Color picker tool for GXDE'
arch=('x86_64' 'aarch64')
url="https://github.com/GXDE-OS/gxde-picker"
license=('GPL-3.0-or-later')
depends=('dtk2widget-qt6-git' 'dtk6core-git' 'qt6-base' 'qt6-svg' 'libx11' 'libxtst' 'wayland' 'libglvnd'
         'libgcc' 'libstdc++' 'glibc')
makedepends=('git' 'cmake' 'ninja' 'pkgconf' 'qt6-tools')
provides=('gxde-picker')
conflicts=('gxde-picker')
source=()
sha512sums=()

# 直接使用 PKGBUILD 所在的 git 仓库作为源码 ・ Build from the git checkout this PKGBUILD lives in.
_srcroot() {
  git -C "$startdir" rev-parse --show-toplevel
}

build() {
  cmake -B build -S "$(_srcroot)" -GNinja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr
  ninja -C build
}

package() {
  DESTDIR="$pkgdir" ninja -C build install
}
